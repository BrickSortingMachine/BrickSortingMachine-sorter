{
  "services": [
    {
      "enabled": true,
      "name": "Message Broker",
      "command": "broker",
      "args": {
        "--port": "8884"
      },
      "restart_attempts": 3,
      "depends_on": []
    },
    {
      "enabled": true,
      "name": "Vision-Service",
      "command": "vision",
      "args": {
        "--host": "192.168.2.111",
        "--collect_class": "None"
      },
      "restart_attempts": 1,
      "depends_on": ["Message Broker"],
      "startup_delay_seconds": 3
    },
    {
      "enabled": true,
      "name": "Classification-Service",
      "command": "classification",
      "args": {
        "--host": "192.168.2.111",
        "--model": "models/2024-08-04_12-44-43_multi-view_abandoned-space.keras"
      },
      "restart_attempts": 1,
      "depends_on": ["Message Broker"],
      "startup_delay_seconds": 3
    },
    {
      "enabled": true,
      "name": "Disabled-Notification-Service",
      "command": "notification",
      "args": {
        "--host": "192.168.2.111",
        "--theme": "robot"
      },
      "restart_attempts": 1,
      "depends_on": ["Message Broker"],
      "startup_delay_seconds": 3
    }
  ]
}
